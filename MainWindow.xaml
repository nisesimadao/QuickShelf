<Window x:Class="QuickShelf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="QuickShelf"
        Icon="Assets/QuickShelf.ico"
        Width="394"
        Height="602"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        AllowsTransparency="False"
        Background="#000000"
        Loaded="Window_Loaded"
        Closed="Window_Closed">
    <Grid x:Name="Root" Background="Transparent">
        <Path x:Name="SurfacePath"
              Fill="#000000"
              Stroke="#18FFFFFF"
              StrokeThickness="1"
              SnapsToDevicePixels="True" />

        <!--
          The ZIP concept renders at 320 CSS px wide inside a 394 px viewport.
          The 24 px top gap belongs to the native inverse fillet, not the HTML.
        -->
        <wv2:WebView2 x:Name="WebView"
                      Margin="74,24,0,0"
                      Visibility="Visible"
                      DefaultBackgroundColor="Black" />
    </Grid>
</Window>
